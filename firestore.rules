rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One row per player: their name, total score, level, country
    match /players/{uid} {
      allow read: if request.auth != null;
      allow create: if isOwner(uid) && validPlayer();
      allow update: if isOwner(uid) && validPlayer()
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score - resource.data.score <= 20000;
      allow delete: if false;
    }

    // Daily puzzle times: one entry per player per day, can't be changed later
    match /daily/{day}/times/{uid} {
      allow read: if request.auth != null;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'time', 'stars', 'country', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.time is int && request.resource.data.time >= 5 && request.resource.data.time <= 86400
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 3
        && request.resource.data.country is string && request.resource.data.country.size() <= 2
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Global Challenge rooms: up to 20 players race on the same puzzle.
    // Anyone signed in can create a room or join one; each player can only change their own entry.
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['status', 'startAt', 'seed', 'size', 'players', 'createdAt'])
        && request.resource.data.players.keys().hasOnly([request.auth.uid])
        && request.resource.data.size >= 5 && request.resource.data.size <= 10;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
        && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.players.size() <= 20;
      allow delete: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validPlayer() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'score', 'level', 'country', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 20
        && d.score is int && d.score >= 0 && d.score <= 100000000
        && d.level is int && d.level >= 1 && d.level <= 100000
        && d.country is string && d.country.size() <= 2
        && d.updatedAt == request.time;
    }
  }
}
